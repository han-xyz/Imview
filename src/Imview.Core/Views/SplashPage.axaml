<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Imview.Core.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="Imview.Core.Views.SplashPage"
             x:DataType="vm:SplashPageViewModel">

    <Grid Background="#1E1E1E">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40">
            
            <!-- Logo and Title -->
            <StackPanel Spacing="20">
                <Border Width="160" 
                        Height="160" 
                        Background="Transparent">
                    <Image Source="avares://Imview.Core/Assets/logo.png"/>
                </Border>
                
                <StackPanel Spacing="8" 
                          HorizontalAlignment="Center">
                    <TextBlock Text="Imview"
                             FontSize="48"
                             FontWeight="Bold"
                             Foreground="White"
                             HorizontalAlignment="Center"/>
                             
                    <TextBlock Text="Imlight Server Management Tool"
                             FontSize="16"
                             Foreground="#CCCCCC"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Client File Status Warning -->
            <Border Background="#8B4513" 
                   CornerRadius="5" 
                   Padding="20"
                   Margin="20,0"
                   IsVisible="{Binding HasRootWadWarning}">
                <StackPanel Spacing="15">
                    <TextBlock Text="{Binding RootWadWarning}"
                              Foreground="White"
                              FontWeight="Medium"
                              TextWrapping="Wrap"
                              HorizontalAlignment="Center"/>
                    
                    <!-- Download Button - only show if connection is available and revision selected -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center" 
                               Spacing="10"
                               IsVisible="{Binding IsConnectionAvailable}">
                        <Button Content="Download Root.wad Now"
                               Command="{Binding DownloadRootWadCommand}"
                               Classes="accent"
                               Padding="15,8"
                               IsEnabled="{Binding !IsDownloadingRootWad}"
                               IsVisible="{Binding HasSelectedRevision}"/>
                        
                        <TextBlock Text="{Binding RootWadDownloadStatus}"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontStyle="Italic"
                                  IsVisible="{Binding IsDownloadingRootWad}"/>
                    </StackPanel>
                    
                    <!-- Settings Button - show when connection fails or no revision -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center" 
                               Spacing="10">
                        <Button Content="Open Client File Settings"
                               Command="{Binding OpenClientFileSettingsCommand}"
                               Classes="accent"
                               Padding="15,8"
                               IsVisible="{Binding ShouldShowSettingsButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- cPanel Style Full-Width Horizontal Sections -->
            <StackPanel Spacing="20" Margin="40,0">
                
                <!-- Game Masters Section -->
                <Border Background="#333333"
                        CornerRadius="6"
                        Padding="25"
                        BorderBrush="#888888"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Game Masters"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 HorizontalAlignment="Left"/>
                        <Rectangle Height="1" 
                                 Fill="#555555" 
                                 HorizontalAlignment="Stretch"/>
                        
                        <!-- Horizontal Button Layout -->
                        <WrapPanel Orientation="Horizontal" 
                                 HorizontalAlignment="Left">
                            <Button Content="Drop Table Editor"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[0].FirstButtonCommand}"
                                    Width="150"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"
                                    Classes="accent"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                
                <!-- Hall Monitors Section -->
                <Border Background="#333333"
                        CornerRadius="6"
                        Padding="25"
                        BorderBrush="#888888"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Hall Monitors"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 HorizontalAlignment="Left"/>
                        <Rectangle Height="1" 
                                 Fill="#555555" 
                                 HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Coming soon..."
                                 FontStyle="Italic"
                                 Foreground="#AAAAAA"
                                 HorizontalAlignment="Left"
                                 Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Data Recollection Section -->
                <Border Background="#333333"
                        CornerRadius="6"
                        Padding="25"
                        BorderBrush="#888888"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Data Recollection"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 HorizontalAlignment="Left"/>
                        <Rectangle Height="1" 
                                 Fill="#555555" 
                                 HorizontalAlignment="Stretch"/>
                        
                        <!-- Horizontal Button Layout -->
                        <WrapPanel Orientation="Horizontal" 
                                 HorizontalAlignment="Left">
                            <Button Content="Quest Editor"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[2].FirstButtonCommand}"
                                    Width="150"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"
                                    Classes="accent"/>
                                    
                            <Button Content="Get Quests From Packet Capture"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[2].SecondButtonCommand}"
                                    Width="220"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>

                            <Button Content="Edit Zone"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[2].ThirdButtonCommand}"
                                    Width="120"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>

                            <Button Content="Download WAD Files"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[2].FourthButtonCommand}"
                                    Width="160"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                
                <!-- General Section -->
                <Border Background="#333333"
                        CornerRadius="6"
                        Padding="25"
                        BorderBrush="#888888"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="General"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 HorizontalAlignment="Left"/>
                        <Rectangle Height="1" 
                                 Fill="#555555" 
                                 HorizontalAlignment="Stretch"/>
                        
                        <!-- Horizontal Button Layout -->
                        <WrapPanel Orientation="Horizontal" 
                                 HorizontalAlignment="Left">
                            <Button Content="Analyze Object Property Blob"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[3].FirstButtonCommand}"
                                    Width="240"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"
                                    Classes="accent"/>
                                    
                            <Button Content="Unpack KIWADs"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[3].SecondButtonCommand}"
                                    Width="150"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>
                                    
                            <Button Content="View WAD Files"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[3].ThirdButtonCommand}"
                                    Width="140"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>
                                    
                            <Button Content="Configure Client Files"
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[3].FourthButtonCommand}"
                                    Width="180"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>

                            <Button Content="Data Pack..."
                                    Command="{Binding $parent[UserControl].((vm:SplashPageViewModel)DataContext).Sections[3].FifthButtonCommand}"
                                    Width="130"
                                    Height="38"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Margin="0,0,15,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>