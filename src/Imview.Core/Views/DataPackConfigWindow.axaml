<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Imview.Core.Views.DataPackConfigWindow"
        Title="Data Pack - Imview"
        Width="560" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="false">

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="Data Pack" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Choose the data pack folder (your spiraldb checkout). Quests, drop tables, decks, inventories and zone transfers are read from and saved to it."
                       TextWrapping="Wrap" Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
            <TextBox Name="PathBox" Grid.Column="0" Watermark="Path to the data pack folder"/>
            <Button Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Click="OnBrowseClick"/>
        </Grid>

        <TextBlock Name="ErrorText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Red"/>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Content="Cancel" Margin="0,0,10,0" Click="OnCancelClick"/>
            <Button Grid.Column="2" Content="Save" Classes="accent" Click="OnSaveClick"/>
        </Grid>
    </Grid>
</Window>
