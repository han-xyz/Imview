<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Imview.Core.ViewModels"
             xmlns:converters="clr-namespace:Imview.Core.Converters"
             xmlns:views="clr-namespace:Imview.Core.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Imview.Core.Views.ZoneEditorView"
             x:DataType="vm:ZoneEditorViewModel">

    <UserControl.Resources>
        <converters:CoordinateConverter x:Key="CoordinateConverter"/>
        <converters:ObjectTypeColorConverter x:Key="ObjectTypeColorConverter"/>
        <converters:ObjectTypeIconConverter x:Key="ObjectTypeIconConverter"/>
    </UserControl.Resources>

    <Grid Background="#2B2B30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="650" MinWidth="400" MaxWidth="1000" />
        </Grid.ColumnDefinitions>

        <!-- Main Zone View Area (Left Side) -->
        <Border Grid.Column="0" 
                Background="#1E1E1E" 
                BorderBrush="#3F3F46" 
                BorderThickness="1"
                Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Zone Toolbar -->
                <Border Grid.Row="0" 
                        Background="#383838" 
                        BorderBrush="#3F3F46"
                        BorderThickness="0,0,0,1"
                        Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Zone:" 
                                 Foreground="White" 
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedZone, TargetNullValue='No zone selected'}"
                                 Foreground="#CCCCCC"
                                 VerticalAlignment="Center"
                                 MinWidth="200"/>
                        <Button Content="Select Zone..."
                                Command="{Binding SelectZoneCommand}"
                                Height="30"
                                Classes="accent"/>
                        <Button Content="Save Zone"
                                Command="{Binding SaveZoneCommand}"
                                Height="30"/>
                    </StackPanel>
                </Border>

                <!-- Zone Visualization Area -->
                <Border Grid.Row="1" 
                        Background="#2D2D30"
                        Padding="5">
                    <Grid>
                        <!-- 2D Visualization Canvas -->
                        <ScrollViewer Name="ZoneScrollViewer"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto"
                                    Background="#1E1E1E">
                            <Canvas Name="ZoneCanvas" 
                                  Background="#1A1A1A"
                                  Width="20000" 
                                  Height="20000">
                                
                                <!-- Coordinate system center marker -->
                                <Ellipse Width="16" Height="16" 
                                       Fill="Red" 
                                       Canvas.Left="9992" 
                                       Canvas.Top="9992"/>
                                <TextBlock Text="(0,0)" 
                                         Foreground="Red" 
                                         FontSize="14"
                                         Canvas.Left="10012" 
                                         Canvas.Top="9995"/>
                                
                                <!-- Grid lines for reference -->
                                <Line StartPoint="0,10000" EndPoint="20000,10000" 
                                    Stroke="#333333" StrokeThickness="1"/>
                                <Line StartPoint="10000,0" EndPoint="10000,20000" 
                                    Stroke="#333333" StrokeThickness="1"/>
                                
                                <!-- Test objects to verify rendering works -->
                                <Border Background="Lime" Width="20" Height="20" 
                                      Canvas.Left="9840" Canvas.Top="9820"
                                      ToolTip.Tip="Test Object Near Expected Position">
                                    <TextBlock Text="T" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <Border Background="Yellow" Width="30" Height="30" 
                                      Canvas.Left="5000" Canvas.Top="5000"
                                      ToolTip.Tip="Test Object at 5000,5000">
                                    <TextBlock Text="5K" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <!-- Zone objects canvas - will be populated programmatically -->
                                <Canvas Name="ZoneObjectCanvas"/>
                            </Canvas>
                        </ScrollViewer>

                        <!-- Overlay canvas for viewport indicators (arrows to off-screen selection) -->
                        <Canvas Name="ViewportOverlay"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Panel.ZIndex="1000"/>
                        
                        <!-- Loading overlay -->
                        <Border Background="#AA000000" 
                              IsVisible="{Binding IsLoading}">
                            <StackPanel HorizontalAlignment="Center" 
                                      VerticalAlignment="Center">
                                <TextBlock Text="Loading Zone Data..."
                                         FontSize="18"
                                         FontWeight="Bold"
                                         Foreground="White"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Please wait while zone objects are processed"
                                         FontSize="12"
                                         Foreground="#CCCCCC"
                                         HorizontalAlignment="Center"
                                         Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Viewport Controls Overlay -->
                        <Border Background="#2B2B30" 
                                CornerRadius="3" 
                                Padding="8" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Bottom" 
                                Margin="10" 
                                Opacity="0.9"
                                IsVisible="{Binding !IsLoading}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding ZoomDisplayText}"
                                         FontSize="10"
                                         Foreground="White"
                                         HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Button Content="+" 
                                            Command="{Binding ZoomInCommand}"
                                            Width="25" Height="25"
                                            FontSize="12"/>
                                    <Button Content="-" 
                                            Command="{Binding ZoomOutCommand}"
                                            Width="25" Height="25"
                                            FontSize="12"/>
                                    <Button Content="Reset" 
                                            Command="{Binding ResetViewCommand}"
                                            Width="45" Height="25"
                                            FontSize="10"/>
                                </StackPanel>
                                <TextBlock Text="WASD to pan"
                                         FontSize="9"
                                         Foreground="#888888"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Ctrl+Mouse wheel to zoom"
                                         FontSize="9"
                                         Foreground="#888888"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag to pan"
                                         FontSize="9"
                                         Foreground="#888888"
                                         HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Visibility Filter Dropdown (Top Right) -->
                        <Border Background="#2B2B30" 
                                CornerRadius="3" 
                                Padding="8" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Margin="10" 
                                Opacity="0.95"
                                IsVisible="{Binding !IsLoading}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Visibility" 
                                         FontSize="10" 
                                         FontWeight="Bold"
                                         Foreground="White" 
                                         HorizontalAlignment="Center"/>
                                
                                <!-- Main Object Type Filters -->
                                <StackPanel Spacing="2">
                                    <CheckBox Content="Zone Objects" 
                                            IsChecked="{Binding ShowZoneObjects}" 
                                            Foreground="White" 
                                            FontSize="9"/>
                                    <CheckBox Content="Collisions" 
                                            IsChecked="{Binding ShowCollisions}" 
                                            Foreground="#00FFFF" 
                                            FontSize="9"/>
                                    <CheckBox Content="NIF Geometry" 
                                            IsChecked="{Binding ShowNifGeometry}" 
                                            Foreground="#FFFF00" 
                                            FontSize="9"/>
                                    <CheckBox Content="Paths &amp; Spawns" 
                                            IsChecked="{Binding ShowPathsAndSpawns}" 
                                            Foreground="#FF8C00" 
                                            FontSize="9"/>
                                    <CheckBox Content="Volumes" 
                                            IsChecked="{Binding ShowVolumes}" 
                                            Foreground="#FF0000" 
                                            FontSize="9"/>
                                    <CheckBox Content="Triggers" 
                                            IsChecked="{Binding ShowTriggers}" 
                                            Foreground="#FF00FF" 
                                            FontSize="9"/>
                                </StackPanel>
                                
                                <!-- Collision Shape Filters -->
                                <Border BorderThickness="1" 
                                        BorderBrush="#555555" 
                                        Background="#1A1A1A" 
                                        CornerRadius="2" 
                                        Padding="4" 
                                        IsVisible="{Binding ShowCollisions}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Collision Shapes" 
                                                 FontSize="8" 
                                                 FontWeight="Bold" 
                                                 Foreground="#CCCCCC" 
                                                 HorizontalAlignment="Center"/>
                                        <CheckBox Content="Box" 
                                                IsChecked="{Binding ShowBoxCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                        <CheckBox Content="Sphere" 
                                                IsChecked="{Binding ShowSphereCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                        <CheckBox Content="Cylinder" 
                                                IsChecked="{Binding ShowCylinderCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                        <CheckBox Content="Tube" 
                                                IsChecked="{Binding ShowTubeCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                        <CheckBox Content="Plane" 
                                                IsChecked="{Binding ShowPlaneCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                        <CheckBox Content="Mesh" 
                                                IsChecked="{Binding ShowMeshCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                        <CheckBox Content="Ray" 
                                                IsChecked="{Binding ShowRayCollisions}" 
                                                FontSize="8" 
                                                Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- Visualization info overlay -->
                        <StackPanel HorizontalAlignment="Right" 
                                  VerticalAlignment="Bottom" 
                                  Margin="10"
                                  Background="#AA000000"
                                  IsVisible="{Binding !IsLoading}">
                            <TextBlock Text="2D Zone View (X/Y Coordinates)"
                                     FontSize="10"
                                     Foreground="#AAAAAA"
                                     Margin="5"/>
                            <TextBlock Text="{Binding ZoneVisualizationObjects.Count, StringFormat='Objects: {0}'}"
                                     FontSize="10"
                                     Foreground="#AAAAAA"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding CollisionVisualizationObjects.Count, StringFormat='Collisions: {0}'}"
                                     FontSize="10"
                                     Foreground="#00FFFF"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding NifMeshVisualizationObjects.Count, StringFormat='NIF Meshes: {0}'}"
                                     FontSize="10"
                                     Foreground="#FFFF00"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding SpawnVisualizationObjects.Count, StringFormat='Spawns: {0}'}"
                                     FontSize="10"
                                     Foreground="#FF8C00"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding PathVisualizationObjects.Count, StringFormat='Paths: {0}'}"
                                     FontSize="10"
                                     Foreground="#FFFF00"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding NodeVisualizationObjects.Count, StringFormat='Nodes: {0}'}"
                                     FontSize="10"
                                     Foreground="#00FF00"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding VolumeVisualizationObjects.Count, StringFormat='Volumes: {0}'}"
                                     FontSize="10"
                                     Foreground="#FF0000"
                                     Margin="5,0,5,5"/>
                            <TextBlock Text="{Binding TriggerVisualizationObjects.Count, StringFormat='Triggers: {0}'}"
                                     FontSize="10"
                                     Foreground="#FF00FF"
                                     Margin="5,0,5,5"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
        <!-- GridSplitter for resizable panels -->
        <GridSplitter Grid.Column="1" Background="#3F3F46" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

        <!-- Right Panel - Unity-like Editor Layout -->
        <Grid Grid.Column="2" Margin="0,5,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            
            <!-- Scene Hierarchy Panel (Left) -->
            <Border Grid.Column="0" 
                    Background="#2B2B30" 
                    BorderBrush="#3F3F46" 
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Scene Hierarchy Header -->
                    <Border Grid.Row="0" 
                            Background="#383838" 
                            BorderBrush="#3F3F46"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                     Text="Scene Hierarchy" 
                                     FontWeight="Bold" 
                                     FontSize="13"
                                     Foreground="White"/>
                            <!-- Flag Legend Button -->
                            <ToggleButton Grid.Column="1" 
                                        Background="#555555" 
                                        CornerRadius="10" 
                                        Padding="4,2" 
                                        Margin="4,0,0,0"
                                        Name="FlagLegendToggle">
                                <TextBlock Text="?" 
                                         Foreground="White" 
                                         FontSize="10" 
                                         FontWeight="Bold" 
                                         TextAlignment="Center"/>
                                
                                <!-- Legend Popup -->
                                <ToggleButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <Border Background="#2B2B30" 
                                                BorderBrush="#3F3F46" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Flag Legend" 
                                                         FontWeight="Bold" 
                                                         FontSize="12" 
                                                         Foreground="White" 
                                                         Margin="0,0,0,8"/>
                                                
                                                <!-- NPC Flag -->
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" 
                                                            Background="#4CAF50" 
                                                            CornerRadius="2" 
                                                            Padding="3,1" 
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="N" 
                                                                 Foreground="White" 
                                                                 FontSize="8" 
                                                                 FontWeight="Bold" 
                                                                 TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" 
                                                             Text="NPC (has NPCBehaviorTemplate)" 
                                                             Foreground="White" 
                                                             FontSize="10" 
                                                             VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Shopkeeper Flag -->
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" 
                                                            Background="#FFD700" 
                                                            CornerRadius="2" 
                                                            Padding="3,1" 
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="$" 
                                                                 Foreground="White" 
                                                                 FontSize="8" 
                                                                 FontWeight="Bold" 
                                                                 TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" 
                                                             Text="Shopkeeper" 
                                                             Foreground="White" 
                                                             FontSize="10" 
                                                             VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Professor Flag -->
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" 
                                                            Background="#2196F3" 
                                                            CornerRadius="2" 
                                                            Padding="3,1" 
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="P" 
                                                                 Foreground="White" 
                                                                 FontSize="8" 
                                                                 FontWeight="Bold" 
                                                                 TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" 
                                                             Text="Professor/Teacher/Trainer" 
                                                             Foreground="White" 
                                                             FontSize="10" 
                                                             VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Teleporter Flag -->
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" 
                                                            Background="#9C27B0" 
                                                            CornerRadius="2" 
                                                            Padding="3,1" 
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="T" 
                                                                 Foreground="White" 
                                                                 FontSize="8" 
                                                                 FontWeight="Bold" 
                                                                 TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" 
                                                             Text="Teleporter/Portal" 
                                                             Foreground="White" 
                                                             FontSize="10" 
                                                             VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </ToggleButton.Flyout>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    
                    <!-- Hierarchy Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Styles>
                            <Style Selector="ScrollBar">
                                <Setter Property="Width" Value="8"/>
                            </Style>
                            <Style Selector="ScrollBar:vertical">
                                <Setter Property="Width" Value="8"/>
                            </Style>
                            <Style Selector="ScrollBar:horizontal">
                                <Setter Property="Height" Value="8"/>
                            </Style>
                        </ScrollViewer.Styles>
                        <StackPanel Margin="0">
                            
                            <!-- Zone Objects -->
                            <StackPanel Background="Transparent" Margin="0">
                                <!-- Zone Objects Header -->
                                <Button Background="#393939" Padding="4,1" Margin="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" CornerRadius="0"
                                        Name="ZoneObjectsToggle">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▼" Foreground="#AAAAAA" FontSize="8" VerticalAlignment="Center" Name="ZoneObjectsArrow"/>
                                        <TextBlock Grid.Column="1" Text="Zone Objects" Foreground="White" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ZoneVisualizationObjects.Count}" Foreground="#888888" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                                <!-- Zone Objects List -->
                                <ListBox ItemsSource="{Binding ZoneVisualizationObjects}" Margin="0" Name="ZoneObjectsList"
                                         Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                         SelectedItem="{Binding SelectedObject, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="2,1" Margin="0" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="○" Foreground="White" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <!-- Object Flags -->
                                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Flags}" Margin="4,0,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Color}" 
                                                                        CornerRadius="2" 
                                                                        Padding="3,1" 
                                                                        ToolTip.Tip="{Binding ToolTip}">
                                                                    <TextBlock Text="{Binding Letter}" 
                                                                             Foreground="White" 
                                                                             FontSize="8" 
                                                                             FontWeight="Bold" 
                                                                             TextAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="#3F5F8F"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="#3A3A3A"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                            
                            <!-- Collision Objects -->
                            <StackPanel Background="Transparent" Margin="0">
                                <!-- Collision Objects Header -->
                                <Button Background="#393939" Padding="4,1" Margin="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" CornerRadius="0"
                                        Name="CollisionObjectsToggle">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▼" Foreground="#AAAAAA" FontSize="8" VerticalAlignment="Center" Name="CollisionObjectsArrow"/>
                                        <TextBlock Grid.Column="1" Text="Collision Objects" Foreground="#00FFFF" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CollisionVisualizationObjects.Count}" Foreground="#888888" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                                
                                <!-- Collision Objects List -->
                                <ListBox ItemsSource="{Binding CollisionVisualizationObjects}" Margin="0" Name="CollisionObjectsList"
                                         Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                         SelectedItem="{Binding SelectedCollision, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="2,1" Margin="0" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="◇" Foreground="#00FFFF" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#00FFFF" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding GeometryType}" Foreground="#888888" FontSize="8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="#1F4F6F"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="#2A3A3A"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                            
                            <!-- Paths &amp; Spawns -->
                            <StackPanel Background="Transparent" Margin="0">
                                <!-- Paths &amp; Spawns Header -->
                                <Button Background="#393939" Padding="4,1" Margin="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" CornerRadius="0"
                                        Name="PathsToggle">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▼" Foreground="#AAAAAA" FontSize="8" VerticalAlignment="Center" Name="PathsArrow"/>
                                        <TextBlock Grid.Column="1" Text="Paths &amp; Spawns" Foreground="#FF8C00" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PathVisualizationObjects.Count}" Foreground="#888888" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                                <!-- Paths &amp; Nodes Tree -->
                                <TreeView ItemsSource="{Binding PathVisualizationObjects}" Margin="0" Name="PathsTree"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          SelectedItem="{Binding SelectedHierarchyItem, Mode=TwoWay}">
                                    <TreeView.DataTemplates>
                                        <!-- Path template with children (nodes + spawns) -->
                                        <TreeDataTemplate DataType="{x:Type vm:PathVisualizationObject}" ItemsSource="{Binding CombinedChildren}">
                                            <Border Background="Transparent" Padding="2,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="→" Foreground="#FF8C00" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FF8C00" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding NodeInfo}" Foreground="#888888" FontSize="8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </TreeDataTemplate>
                                        
                                        <!-- Node template (leaf) -->
                                        <TreeDataTemplate DataType="{x:Type vm:NodeVisualizationObject}">
                                            <Border Background="Transparent" Padding="2,1" Margin="-6,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="•" Foreground="#00FF00" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="#00FF00" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CoordinateText}" Foreground="#888888" FontSize="8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </TreeDataTemplate>

                                        <!-- Spawn template (leaf) -->
                                        <TreeDataTemplate DataType="{x:Type vm:SpawnVisualizationObject}">
                                            <Border Background="Transparent" Padding="2,1" Margin="-6,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="C" Foreground="#FFA500" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FFA500" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CreatureType}" Foreground="#888888" FontSize="8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </TreeDataTemplate>
                                    </TreeView.DataTemplates>
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                        <Style Selector="TreeViewItem:selected">
                                            <Setter Property="Background" Value="#4F3F1F"/>
                                        </Style>
                                        <Style Selector="TreeViewItem:pointerover">
                                            <Setter Property="Background" Value="#3A2A1A"/>
                                        </Style>
                                    </TreeView.Styles>
                                </TreeView>
                            </StackPanel>
                            
                            <!-- NIF Geometry -->
                            <StackPanel Background="Transparent" Margin="0">
                                <!-- NIF Geometry Header -->
                                <Button Background="#393939" Padding="4,1" Margin="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" CornerRadius="0"
                                        Name="NifGeometryToggle">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="►" Foreground="#AAAAAA" FontSize="8" VerticalAlignment="Center" Name="NifGeometryArrow"/>
                                        <TextBlock Grid.Column="1" Text="NIF Geometry" Foreground="#FFFF00" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding NifMeshVisualizationObjects.Count}" Foreground="#888888" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                                <!-- NIF Geometry List -->
                                <ListBox ItemsSource="{Binding NifMeshVisualizationObjects}" Margin="0" Name="NifGeometryList"
                                         Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                         IsVisible="False"
                                         SelectedItem="{Binding SelectedMesh, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="2,1" Margin="0" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="▲" Foreground="#FFFF00" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#FFFF00" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding GeometryInfo}" Foreground="#888888" FontSize="8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="#4F4F1F"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="#3A3A1A"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                            
                            <!-- Volumes -->
                            <StackPanel Background="Transparent" Margin="0">
                                <!-- Volumes Header -->
                                <Button Background="#393939" Padding="4,1" Margin="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" CornerRadius="0"
                                        Name="VolumesToggle">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▼" Foreground="#AAAAAA" FontSize="8" VerticalAlignment="Center" Name="VolumesArrow"/>
                                        <TextBlock Grid.Column="1" Text="Volumes" Foreground="#FF0000" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VolumeVisualizationObjects.Count}" Foreground="#888888" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                                <!-- Volumes List -->
                                <ListBox ItemsSource="{Binding VolumeVisualizationObjects}" Margin="0" Name="VolumesList"
                                         Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                         SelectedItem="{Binding SelectedVolume, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="2,1" Margin="0" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="□" Foreground="#FF0000" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#FF0000" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PrimitiveType}" Foreground="#888888" FontSize="8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="#4F1F1F"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="#3A1A1A"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                            
                            <!-- Triggers -->
                            <StackPanel Background="Transparent" Margin="0">
                                <!-- Triggers Header -->
                                <Button Background="#393939" Padding="4,1" Margin="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" CornerRadius="0"
                                        Name="TriggersToggle">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▼" Foreground="#AAAAAA" FontSize="8" VerticalAlignment="Center" Name="TriggersArrow"/>
                                        <TextBlock Grid.Column="1" Text="Triggers" Foreground="#FF00FF" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TriggerVisualizationObjects.Count}" Foreground="#888888" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                                <!-- Triggers List -->
                                <ListBox ItemsSource="{Binding TriggerVisualizationObjects}" Margin="0" Name="TriggersList"
                                         Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                         SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="2,1" Margin="0" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="⚡" Foreground="#FF00FF" FontSize="8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#FF00FF" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <!-- Trigger Flags -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                        <ItemsControl ItemsSource="{Binding Flags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding Color}" 
                                                                            CornerRadius="2" 
                                                                            Padding="3,1" 
                                                                            ToolTip.Tip="{Binding ToolTip}">
                                                                        <TextBlock Text="{Binding Letter}" 
                                                                                 Foreground="White" 
                                                                                 FontSize="8" 
                                                                                 FontWeight="Bold" 
                                                                                 TextAlignment="Center"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="#4F1F4F"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="#3A1A3A"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                        Background="#3F3F46" 
                        ResizeDirection="Columns" 
                        ResizeBehavior="PreviousAndNext" />
            
            <!-- Properties Panel (Right) -->
            <Border Grid.Column="2" 
                    Background="#2B2B30" 
                    BorderBrush="#3F3F46" 
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Properties Panel Header -->
                    <Border Grid.Row="0"
                            Background="#383838"
                            BorderBrush="#3F3F46"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Properties"
                                     FontWeight="Bold"
                                     FontSize="13"
                                     Foreground="White"/>
                            <Button Grid.Column="1" Content="📋 JSON Object"
                                    FontSize="10" Height="22"
                                    Background="#3A5A8A" Foreground="White"
                                    BorderBrush="#5A7AAA" BorderThickness="1"
                                    ToolTip.Tip="Export selected object as JSON file"
                                    Command="{Binding ExportSelectedAsJsonCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Properties Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0" Margin="0">
                            
                            <!-- Transform Properties (First - Most Important) -->
                            <StackPanel IsVisible="{Binding HasSelectedAnyObject}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="5,3" Margin="0">
                                    <TextBlock Text="Transform" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <!-- Position -->
                                    <TextBlock Text="Position" Foreground="#CCCCCC" FontSize="10" FontWeight="Bold" Margin="0,3,0,3"/>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,1">
                                        <TextBlock Text="X" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Y" Grid.Row="0" Grid.Column="1" 
                                                 Foreground="#CCCCCC" FontSize="8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Z" Grid.Row="0" Grid.Column="2" 
                                                 Foreground="#CCCCCC" FontSize="8" HorizontalAlignment="Center"/>
                                        
                                        <TextBox Text="{Binding CurrentLocationX}" 
                                               Grid.Row="1" Grid.Column="0" 
                                               Height="18" FontSize="8" Margin="0,1,1,0"/>
                                        <TextBox Text="{Binding CurrentLocationY}" 
                                               Grid.Row="1" Grid.Column="1" 
                                               Height="18" FontSize="8" Margin="1,1,1,0"/>
                                        <TextBox Text="{Binding CurrentLocationZ}" 
                                               Grid.Row="1" Grid.Column="2" 
                                               Height="18" FontSize="8" Margin="1,1,0,0"/>
                                    </Grid>
                                    
                                    <!-- Rotation (Zone Objects Only) -->
                                    <StackPanel IsVisible="{Binding HasSelectedObject}" Margin="0,4,0,0">
                                        <TextBlock Text="Rotation" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,1">
                                            <TextBlock Text="X" Grid.Row="0" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Y" Grid.Row="0" Grid.Column="1" 
                                                     Foreground="#CCCCCC" FontSize="8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Z" Grid.Row="0" Grid.Column="2" 
                                                     Foreground="#CCCCCC" FontSize="8" HorizontalAlignment="Center"/>
                                            
                                            <TextBox Text="{Binding OrientationX}" 
                                                   Grid.Row="1" Grid.Column="0" 
                                                   Height="18" FontSize="8" Margin="0,1,1,0"/>
                                            <TextBox Text="{Binding OrientationY}" 
                                                   Grid.Row="1" Grid.Column="1" 
                                                   Height="18" FontSize="8" Margin="1,1,1,0"/>
                                            <TextBox Text="{Binding OrientationZ}" 
                                                   Grid.Row="1" Grid.Column="2" 
                                                   Height="18" FontSize="8" Margin="1,1,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Scale -->
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="Scale" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding CurrentScale}" Height="18" FontSize="8"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Core Object Properties (Second) -->
                            <StackPanel IsVisible="{Binding HasSelectedObject}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="5,3" Margin="0">
                                    <TextBlock Text="Core Object" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                                          Margin="0,2">
                                        <!-- Name -->
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCoreObject.m_zoneTag}" 
                                               Grid.Row="0" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Template ID -->
                                        <TextBlock Text="Template ID:" Grid.Row="1" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCoreObject.m_templateID}" 
                                               Grid.Row="1" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Object ID -->
                                        <TextBlock Text="Object ID:" Grid.Row="2" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCoreObject.m_nObjectID}" 
                                               Grid.Row="2" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Start State -->
                                        <TextBlock Text="Start State:" Grid.Row="3" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCoreObject.m_startState}" 
                                               Grid.Row="3" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Override Name -->
                                        <TextBlock Text="Override Name:" Grid.Row="4" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCoreObject.m_overrideName}" 
                                               Grid.Row="4" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Loading Type -->
                                        <TextBlock Text="Loading Type:" Grid.Row="5" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCoreObject.m_loadingType}" 
                                               Grid.Row="5" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                    </Grid>
                                    
                                    <!-- Flags -->
                                    <StackPanel Margin="0,4,0,0">
                                        <CheckBox Content="Global Dynamic" 
                                                IsChecked="{Binding SelectedCoreObject.m_globalDynamic}"
                                                Foreground="White" FontSize="9" Margin="0,1"/>
                                        <CheckBox Content="Undetectable" 
                                                IsChecked="{Binding SelectedCoreObject.m_bUndetectable}"
                                                Foreground="White" FontSize="9" Margin="0,1"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Template Properties (Third) -->
                            <StackPanel IsVisible="{Binding SelectedTemplate, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Template" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedTemplateTypeName}" 
                                                 Foreground="#CCCCCC" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Template Properties -->
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="Template loaded successfully" 
                                             FontSize="9" 
                                             Foreground="#90EE90" 
                                             Margin="0,0,0,4"/>
                                    
                                    <!-- GameObjectTemplate Properties -->
                                    <StackPanel IsVisible="{Binding SelectedGameObjectTemplate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                                              Margin="0,2">
                                            <!-- Object Name -->
                                            <TextBlock Text="Object Name:" Grid.Row="0" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,1">
                                                <!-- Locale ID -->
                                                <TextBox Text="{Binding SelectedTemplateObjectNameLocaleId}" 
                                                       Height="18" FontSize="8" 
                                                       IsReadOnly="True"
                                                       Background="#333333"
                                                       Foreground="#AAAAAA"
                                                       ToolTip.Tip="Locale ID"/>
                                                <!-- Resolved English Text -->
                                                <TextBox Text="{Binding SelectedTemplateObjectNameResolved}" 
                                                       Height="18" FontSize="8" Margin="0,2,0,0"
                                                       IsReadOnly="True"
                                                       Background="#1E3A1E"
                                                       Foreground="#90EE90"
                                                       ToolTip.Tip="Resolved English text from locale service"
                                                       IsVisible="{Binding SelectedTemplateObjectNameResolved, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            
                                            <!-- Template ID -->
                                            <TextBlock Text="Template ID:" Grid.Row="1" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SelectedGameObjectTemplate.m_templateID}" 
                                                   Grid.Row="1" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                            
                                            <!-- Visual ID -->
                                            <TextBlock Text="Visual ID:" Grid.Row="2" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SelectedGameObjectTemplate.m_visualID}" 
                                                   Grid.Row="2" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                            
                                            <!-- Display Name -->
                                            <TextBlock Text="Display Name:" Grid.Row="3" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,1">
                                                <!-- Locale ID -->
                                                <TextBox Text="{Binding SelectedTemplateDisplayNameLocaleId}" 
                                                       Height="18" FontSize="8" 
                                                       IsReadOnly="True"
                                                       Background="#333333"
                                                       Foreground="#AAAAAA"
                                                       ToolTip.Tip="Locale ID"/>
                                                <!-- Resolved English Text -->
                                                <TextBox Text="{Binding SelectedTemplateDisplayNameResolved}" 
                                                       Height="18" FontSize="8" Margin="0,2,0,0"
                                                       IsReadOnly="True"
                                                       Background="#1E3A1E"
                                                       Foreground="#90EE90"
                                                       ToolTip.Tip="Resolved English text from locale service"
                                                       IsVisible="{Binding SelectedTemplateDisplayNameResolved, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            
                                            <!-- Description -->
                                            <TextBlock Text="Description:" Grid.Row="4" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,1">
                                                <!-- Locale ID -->
                                                <TextBox Text="{Binding SelectedTemplateDescriptionLocaleId}" 
                                                       Height="18" FontSize="8" 
                                                       IsReadOnly="True"
                                                       Background="#333333"
                                                       Foreground="#AAAAAA"
                                                       ToolTip.Tip="Locale ID"/>
                                                <!-- Resolved English Text -->
                                                <TextBox Text="{Binding SelectedTemplateDescriptionResolved}" 
                                                       Height="18" FontSize="8" Margin="0,2,0,0"
                                                       IsReadOnly="True"
                                                       Background="#1E3A1E"
                                                       Foreground="#90EE90"
                                                       ToolTip.Tip="Resolved English text from locale service"
                                                       IsVisible="{Binding SelectedTemplateDescriptionResolved, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            
                                            <!-- Object Type -->
                                            <TextBlock Text="Object Type:" Grid.Row="5" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SelectedGameObjectTemplate.m_nObjectType}" 
                                                   Grid.Row="5" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                            
                                            <!-- Icon -->
                                            <TextBlock Text="Icon:" Grid.Row="6" Grid.Column="0" 
                                                     Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SelectedGameObjectTemplate.m_sIcon}" 
                                                   Grid.Row="6" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        </Grid>
                                        
                                        <!-- Flags -->
                                        <StackPanel Margin="0,4,0,0">
                                            <CheckBox Content="Exempt From AOI" 
                                                    IsChecked="{Binding SelectedGameObjectTemplate.m_exemptFromAOI}"
                                                    Foreground="White" FontSize="9" Margin="0,1"/>
                                        </StackPanel>
                                        
                                        <!-- Adjectives -->
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="Adjectives:" FontSize="9" FontWeight="Bold" 
                                                     Foreground="#CCCCCC" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding SelectedGameObjectTemplate.m_adjectiveList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="8" 
                                                                 Foreground="#AAAAAA" Margin="2,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        
                                        <!-- Behaviors -->
                                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding SelectedGameObjectTemplateBehaviors.Count}">
                                            <TextBlock Text="{Binding SelectedGameObjectTemplateBehaviors.Count, StringFormat='Behaviors ({0}):'}" FontSize="11" FontWeight="Bold" 
                                                     Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding SelectedGameObjectTemplateBehaviors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#333333" Margin="0,3" Padding="10,6" CornerRadius="4">
                                                            <StackPanel>
                                                                <!-- Behavior Header with Type Name -->
                                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                                    <TextBlock Text="Type:" Grid.Column="0" FontSize="10" FontWeight="Bold" 
                                                                             Foreground="#FFD700" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding TypeName}" Grid.Column="1" FontSize="10" FontWeight="Bold" 
                                                                             Foreground="#FFD700"/>
                                                                </Grid>
                                                                
                                                                <!-- JSON Content -->
                                                                <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Auto" 
                                                                            VerticalScrollBarVisibility="Auto">
                                                                    <TextBox Text="{Binding FormattedJson}" IsReadOnly="True" FontSize="9" 
                                                                           FontFamily="Consolas,Monaco,monospace" Background="#1E1E1E" 
                                                                           Foreground="#D4D4D4" TextWrapping="Wrap" 
                                                                           AcceptsReturn="True" BorderThickness="1" 
                                                                           BorderBrush="#555555" Padding="6"
                                                                           MinHeight="40"/>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        
                                        <!-- NPC Database Actions -->
                                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding IsSelectedObjectNpc}">
                                            <TextBlock Text="NPC Data Pack Actions" FontSize="11" FontWeight="Bold" 
                                                     Foreground="#4CAF50" Margin="0,0,0,8"/>

                                            <!-- Actions only when DB is available -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsVisible="{Binding IsWorldDatabaseReady}">
                                                <Button Content="Edit Inventory" 
                                                        Command="{Binding EditNpcInventoryCommand}"
                                                        Height="30" Width="120"
                                                        Background="#4CAF50"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        Margin="0,0,8,0"
                                                        ToolTip.Tip="Edit this NPC's inventory in the data pack">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover">
                                                            <Setter Property="Background" Value="#45A049"/>
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                                <Button Content="Edit Spells" 
                                                        Command="{Binding EditNpcSpellInventoryCommand}"
                                                        Height="30" Width="120"
                                                        Background="#2196F3"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        ToolTip.Tip="Edit this NPC's spell inventory in the data pack">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover">
                                                            <Setter Property="Background" Value="#1976D2"/>
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </StackPanel>

                                            <!-- Fallback status when DB not available -->
                                            <TextBlock Text="{Binding WorldDatabaseStatusText}"
                                                     FontSize="8" 
                                                     Foreground="#888888" 
                                                     FontStyle="Italic"
                                                     Margin="0,4,0,0"
                                                     IsVisible="{Binding NotWorldDatabaseReady}"/>
                                        </StackPanel>
                                        
                                        <!-- Loot Tables -->
                                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding HasLootTables}">
                                            <TextBlock Text="{Binding SelectedTemplateLootTables.Count, StringFormat='Loot Tables ({0}):'}" FontSize="11" FontWeight="Bold" 
                                                     Foreground="#FF6B35" Margin="0,0,0,8"/>
                                            
                                            <!-- Loot Tables List -->
                                            <ItemsControl ItemsSource="{Binding SelectedTemplateLootTableItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#2A2A2A" Margin="0,2" Padding="8,4" CornerRadius="3" BorderBrush="#FF6B35" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Loot Table Name -->
                                                                <TextBlock Grid.Column="0" 
                                                                         Text="{Binding Name}" 
                                                                         FontSize="10" 
                                                                         FontWeight="Bold"
                                                                         Foreground="#FF6B35" 
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,8,0"/>
                                                                
                                                                <!-- Open/Create Button depending on existence -->
                                                                <Button Grid.Column="1" 
                                                                        Content="{Binding Label}"
                                                                        Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).OpenOrCreateDropTableCommand}"
                                                                        CommandParameter="{Binding Name}"
                                                                        Height="24" 
                                                                        Width="70"
                                                                        FontSize="9"
                                                                        Background="#4CAF50"
                                                                        Foreground="White">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button:pointerover">
                                                                            <Setter Property="Background" Value="#45A049"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Non-GameObjectTemplate fallback -->
                                    <StackPanel IsVisible="{Binding SelectedGameObjectTemplate, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="Template Type Information:" 
                                                 FontSize="9" FontWeight="Bold" 
                                                 Foreground="#CCCCCC" 
                                                 Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedTemplate}" 
                                               FontSize="8" 
                                               TextWrapping="Wrap"
                                               Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Template Loading Message -->
                            <StackPanel IsVisible="{Binding HasSelectedObject}" Margin="0">
                                <StackPanel IsVisible="{Binding SelectedTemplate, Converter={x:Static ObjectConverters.IsNull}}">
                                    <!-- Header -->
                                    <Border Background="#393939" Padding="4,2" Margin="0">
                                        <TextBlock Text="Template" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    
                                    <!-- Loading Message -->
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="Loading template..." 
                                                 FontSize="9" 
                                                 Foreground="#FFA500" 
                                                 Margin="0,0,0,2"/>
                                        <TextBlock Text="Template data will appear here once loaded from Root.wad" 
                                                 FontSize="8" 
                                                 Foreground="#888888" 
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Collision Object Properties -->
                            <StackPanel IsVisible="{Binding HasSelectedCollision}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="Collision Object" Foreground="#00FFFF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                          Margin="0,2">
                                        <!-- Name -->
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCollision.Name}" 
                                               Grid.Row="0" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Geometry Type -->
                                        <TextBlock Text="Geometry Type:" Grid.Row="1" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCollision.GeometryType}" 
                                               Grid.Row="1" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Material -->
                                        <TextBlock Text="Material:" Grid.Row="2" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCollision.Material}" 
                                               Grid.Row="2" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Category Flags -->
                                        <TextBlock Text="Category Flags:" Grid.Row="3" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCollision.CategoryFlags}" 
                                               Grid.Row="3" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Collision Flags -->
                                        <TextBlock Text="Collision Flags:" Grid.Row="4" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedCollision.CollisionFlags}" 
                                               Grid.Row="4" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Volume Object Properties -->
                            <StackPanel IsVisible="{Binding HasSelectedVolume}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="Volume Object" Foreground="#FF0000" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                                          Margin="0,2">
                                        <!-- Name -->
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.Name}" 
                                               Grid.Row="0" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Template ID -->
                                        <TextBlock Text="Template ID:" Grid.Row="1" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.TemplateID}" 
                                               Grid.Row="1" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Primitive Type -->
                                        <TextBlock Text="Primitive Type:" Grid.Row="2" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.PrimitiveType}" 
                                               Grid.Row="2" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Radius -->
                                        <TextBlock Text="Radius:" Grid.Row="3" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.Radius}" 
                                               Grid.Row="3" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Length -->
                                        <TextBlock Text="Length:" Grid.Row="4" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.Length}" 
                                               Grid.Row="4" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Width -->
                                        <TextBlock Text="Width:" Grid.Row="5" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.Width}" 
                                               Grid.Row="5" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Dimensions Text -->
                                        <TextBlock Text="Dimensions:" Grid.Row="6" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedVolume.DimensionsText}" 
                                               Grid.Row="6" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                    </Grid>
                                    
                                    <!-- Events -->
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="Events" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                        
                                        <!-- Enter Events -->
                                        <StackPanel Margin="0,2,0,0">
                                            <TextBlock Text="Enter Events:" FontSize="8" Foreground="#CCCCCC" Margin="0,0,0,1"/>
                                            <ItemsControl ItemsSource="{Binding SelectedVolume.EnterEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="8" 
                                                                 Foreground="#90EE90" Margin="4,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="(No enter events)" FontSize="8" Foreground="#888888" Margin="4,1"
                                                     IsVisible="{Binding !SelectedVolume.EnterEvents.Count}"/>
                                        </StackPanel>
                                        
                                        <!-- Exit Events -->
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="Exit Events:" FontSize="8" Foreground="#CCCCCC" Margin="0,0,0,1"/>
                                            <ItemsControl ItemsSource="{Binding SelectedVolume.ExitEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="8" 
                                                                 Foreground="#FFB6C1" Margin="4,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="(No exit events)" FontSize="8" Foreground="#888888" Margin="4,1"
                                                     IsVisible="{Binding !SelectedVolume.ExitEvents.Count}"/>
                                        </StackPanel>
                                        
                                        <!-- Related Triggers -->
                                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding SelectedVolumeEnterTriggers.Count}">
                                            <TextBlock Text="Related Enter Triggers" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding SelectedVolumeEnterTriggers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#2A3F2A" Margin="0,2" Padding="6,3" CornerRadius="3" 
                                                                BorderBrush="#4F6F4F" BorderThickness="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="8" 
                                                                         Foreground="#90EE90" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="→" 
                                                                        Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).SelectRelatedTriggerCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="20" Height="16" FontSize="8"
                                                                        Background="#3F5F3F" Foreground="White"
                                                                        BorderBrush="#5F7F5F" BorderThickness="1"
                                                                        ToolTip.Tip="Select this trigger"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        
                                        <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedVolumeExitTriggers.Count}">
                                            <TextBlock Text="Related Exit Triggers" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding SelectedVolumeExitTriggers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#3F2A2A" Margin="0,2" Padding="6,3" CornerRadius="3" 
                                                                BorderBrush="#6F4F4F" BorderThickness="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="8" 
                                                                         Foreground="#FFB6C1" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="→" 
                                                                        Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).SelectRelatedTriggerCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="20" Height="16" FontSize="8"
                                                                        Background="#5F3F3F" Foreground="White"
                                                                        BorderBrush="#7F5F5F" BorderThickness="1"
                                                                        ToolTip.Tip="Select this trigger"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Trigger Object Properties -->
                            <StackPanel IsVisible="{Binding HasSelectedTrigger}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="Trigger Object" Foreground="#FF00FF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                                          Margin="0,2">
                                        <!-- Name -->
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedTrigger.Name}" 
                                               Grid.Row="0" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Trigger Type -->
                                        <TextBlock Text="Trigger Type:" Grid.Row="1" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedTrigger.TriggerType}" 
                                               Grid.Row="1" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Zone -->
                                        <TextBlock Text="Zone:" Grid.Row="2" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedTrigger.Zone}" 
                                               Grid.Row="2" Grid.Column="1" Height="20" FontSize="9" Margin="0,1"/>
                                        
                                        <!-- Location -->
                                        <TextBlock Text="Location:" Grid.Row="3" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedTrigger.LocationText}" 
                                               Grid.Row="3" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Timing -->
                                        <TextBlock Text="Timing:" Grid.Row="4" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedTrigger.TimingText}" 
                                               Grid.Row="4" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                        
                                        <!-- Events Count -->
                                        <TextBlock Text="Events:" Grid.Row="5" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SelectedTrigger.EventsText}" 
                                               Grid.Row="5" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                    </Grid>
                                    
                                    <!-- Events Detail -->
                                    <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedTrigger.Events.Count}">
                                        <TextBlock Text="Event Details" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTrigger.Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#333333" Margin="0,2" Padding="6,4" CornerRadius="3">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding}" FontSize="8" 
                                                                     Foreground="#FFB6C1" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    
                                    <!-- Results -->
                                    <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedTrigger.WrappedResults.Count}">
                                        <TextBlock Text="Results" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <Border Background="#2A2A30" BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="2" Padding="2" MaxHeight="800">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SelectedTrigger.WrappedResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1E1E1E" Margin="0,2" Padding="6" CornerRadius="2" BorderBrush="#444" BorderThickness="1">
                                                                <StackPanel>
                                                                    <!-- Header with type name and buttons -->
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                                                        <TextBlock Grid.Column="0" Text="{Binding TypeName}" FontSize="11" FontWeight="Bold"
                                                                                 Foreground="#569CD6" VerticalAlignment="Center"/>
                                                                        <!-- Modify button for existing teleports -->
                                                                        <Button Grid.Column="1" Content="Modify" Width="60" Height="20" FontSize="10" Margin="2,0"
                                                                                Background="#2A4A2A" Foreground="White" BorderBrush="#4A6A4A"
                                                                                ToolTip.Tip="Modify teleport data in database"
                                                                                IsVisible="{Binding CanEdit}"
                                                                                Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).EditTeleportCommand}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <!-- Create button for missing teleports -->
                                                                        <Button Grid.Column="2" Content="Create" Width="60" Height="20" FontSize="10" Margin="2,0"
                                                                                Background="#4A2A2A" Foreground="White" BorderBrush="#6A4A4A"
                                                                                ToolTip.Tip="Create new teleport data in database"
                                                                                IsVisible="{Binding CanCreate}"
                                                                                Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).CreateTeleportCommand}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                    <!-- JSON code block -->
                                                                    <TextBox Text="{Binding FormattedJson}" IsReadOnly="True" FontSize="11"
                                                                           FontFamily="Consolas,Monaco,monospace" Background="#1E1E1E"
                                                                           Foreground="#D4D4D4" TextWrapping="Wrap"
                                                                           AcceptsReturn="True" BorderThickness="0" Padding="6"
                                                                           MinHeight="50" MaxHeight="400"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <!-- Requirements -->
                                    <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedTrigger.WrappedRequirements.Count}">
                                        <TextBlock Text="Requirements" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <Border Background="#2A2A30" BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="2" Padding="2" MaxHeight="600">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SelectedTrigger.WrappedRequirements}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1E1E1E" Margin="0,2" Padding="6" CornerRadius="2" BorderBrush="#444" BorderThickness="1">
                                                                <StackPanel>
                                                                    <!-- Header with type name -->
                                                                    <TextBlock Text="{Binding TypeName}" FontSize="11" FontWeight="Bold"
                                                                             Foreground="#4EC9B0" Margin="0,0,0,4"/>
                                                                    <!-- JSON code block -->
                                                                    <TextBox Text="{Binding FormattedJson}" IsReadOnly="True" FontSize="11"
                                                                           FontFamily="Consolas,Monaco,monospace" Background="#1E1E1E"
                                                                           Foreground="#D4D4D4" TextWrapping="Wrap"
                                                                           AcceptsReturn="True" BorderThickness="0" Padding="6"
                                                                           MinHeight="50" MaxHeight="400"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Related Volumes -->
                                    <StackPanel Margin="0,8,0,0" IsVisible="{Binding SelectedTriggerActivatingVolumes.Count}">
                                        <TextBlock Text="Volumes That Activate This Trigger" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTriggerActivatingVolumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#2A3F2A" Margin="0,2" Padding="6,3" CornerRadius="3" 
                                                            BorderBrush="#4F6F4F" BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="8" 
                                                                     Foreground="#90EE90" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="→" 
                                                                    Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).SelectRelatedVolumeCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="20" Height="16" FontSize="8"
                                                                    Background="#3F5F3F" Foreground="White"
                                                                    BorderBrush="#5F7F5F" BorderThickness="1"
                                                                    ToolTip.Tip="Select this volume"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    
                                    <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedTriggerDeactivatingVolumes.Count}">
                                        <TextBlock Text="Volumes That Deactivate This Trigger" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTriggerDeactivatingVolumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#3F2A2A" Margin="0,2" Padding="6,3" CornerRadius="3" 
                                                            BorderBrush="#6F4F4F" BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="8" 
                                                                     Foreground="#FFB6C1" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="→" 
                                                                    Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).SelectRelatedVolumeCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="20" Height="16" FontSize="8"
                                                                    Background="#5F3F3F" Foreground="White"
                                                                    BorderBrush="#7F5F5F" BorderThickness="1"
                                                                    ToolTip.Tip="Select this volume"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    
                                    <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedTriggerFireVolumes.Count}">
                                        <TextBlock Text="Volumes That Fire This Trigger" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTriggerFireVolumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#3F3F2A" Margin="0,2" Padding="6,3" CornerRadius="3" 
                                                            BorderBrush="#6F6F4F" BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="8" 
                                                                     Foreground="#FFFF90" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="→" 
                                                                    Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).SelectRelatedVolumeCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="20" Height="16" FontSize="8"
                                                                    Background="#5F5F3F" Foreground="White"
                                                                    BorderBrush="#7F7F5F" BorderThickness="1"
                                                                    ToolTip.Tip="Select this volume"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Path Object Properties -->
                            <StackPanel IsVisible="{Binding HasSelectedPath}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="Path Object" Foreground="#FF8C00" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                          Margin="0,2">
                                        <!-- Name -->
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedPathName}" Grid.Row="0" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        
                                        <!-- Path ID -->
                                        <TextBlock Text="ID:" Grid.Row="1" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedPathId}" Grid.Row="1" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Type -->
                                        <TextBlock Text="Type:" Grid.Row="2" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedPathType}" Grid.Row="2" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Node Count -->
                                        <TextBlock Text="Nodes:" Grid.Row="3" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedPathNodeCount}" Grid.Row="3" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Spawn Count -->
                                        <TextBlock Text="Spawns:" Grid.Row="4" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedPathSpawnCount}" Grid.Row="4" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                    </Grid>
                                    
                                    <!-- All path properties via reflection -->
                                    <TextBlock Text="All Path Properties:" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="2" Padding="4" MaxHeight="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedPathAllProperties}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#AAAAAA" FontSize="8" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#FFFFFF" FontSize="8" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Node Properties -->
                            <StackPanel IsVisible="{Binding HasSelectedNode}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="Waypoint (Node)" Foreground="#00FF00" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2">
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" Foreground="#CCCCCC" FontSize="9" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedNodeName}" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="9"/>

                                        <TextBlock Text="ID:" Grid.Row="1" Grid.Column="0" Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedNodeId}" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="9"/>

                                        <TextBlock Text="Path:" Grid.Row="2" Grid.Column="0" Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedNodePath}" Grid.Row="2" Grid.Column="1" Foreground="White" FontSize="9"/>

                                        <TextBlock Text="Location:" Grid.Row="3" Grid.Column="0" Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedNodeLocation}" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="9"/>
                                    </Grid>

                                    <!-- All node properties via reflection -->
                                    <TextBlock Text="All Node Properties:" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="2" Padding="4" MaxHeight="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedNodeAllProperties}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#AAAAAA" FontSize="8" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#FFFFFF" FontSize="8" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Spawn Object Properties -->
                            <StackPanel IsVisible="{Binding HasSelectedSpawn}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="Spawn Object" Foreground="#FF8C00" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Properties -->
                                <StackPanel Margin="4,2">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                                          Margin="0,2">
                                        <!-- Name -->
                                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnName}" Grid.Row="0" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        
                                        <!-- Spawn ID -->
                                        <TextBlock Text="ID:" Grid.Row="1" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnId}" Grid.Row="1" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Template ID -->
                                        <TextBlock Text="Template:" Grid.Row="2" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnTemplateId}" Grid.Row="2" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Type -->
                                        <TextBlock Text="Type:" Grid.Row="3" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnType}" Grid.Row="3" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Path -->
                                        <TextBlock Text="Path:" Grid.Row="4" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnPath}" Grid.Row="4" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Location -->
                                        <TextBlock Text="Location:" Grid.Row="5" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnLocation}" Grid.Row="5" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                        
                                        <!-- Spawn Chance -->
                                        <TextBlock Text="Chance:" Grid.Row="6" Grid.Column="0" 
                                                 Foreground="#CCCCCC" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding SelectedSpawnChance}" Grid.Row="6" Grid.Column="1" 
                                                 Foreground="White" FontSize="9" 
                                                 VerticalAlignment="Center" Margin="0,2,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Spawn Template Properties (similar to Core Object Template) -->
                            <StackPanel IsVisible="{Binding HasSelectedSpawn}" Margin="0">
                                <!-- Loaded Template -->
                                <StackPanel IsVisible="{Binding SelectedSpawnTemplate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <!-- Header -->
                                    <Border Background="#393939" Padding="4,2" Margin="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Template" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                                            <!-- Optional: show class name if available -->
                                            <TextBlock Text="{Binding SelectedSpawnTemplateClassName}" 
                                                     Foreground="#CCCCCC" FontSize="9" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Template Properties -->
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="Template loaded for spawn" 
                                                 FontSize="9" 
                                                 Foreground="#90EE90" 
                                                 Margin="0,0,0,4"/>
                                        
                                        <!-- If it's a GameObjectTemplate, show key fields -->
                                        <StackPanel IsVisible="{Binding SelectedSpawnGameObjectTemplate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2">
                                                <!-- Template ID (already shown above, but safe to repeat context) -->
                                                <TextBlock Text="Template ID:" Grid.Row="0" Grid.Column="0" 
                                                         Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SelectedSpawnTemplateId}" 
                                                       Grid.Row="0" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                                
                                                <!-- Display Name / Object Name / Description (raw locale keys) -->
                                                <TextBlock Text="Object Name:" Grid.Row="1" Grid.Column="0" 
                                                         Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SelectedSpawnTemplateObjectName}" 
                                                       Grid.Row="1" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                                
                                                <TextBlock Text="Display Name:" Grid.Row="2" Grid.Column="0" 
                                                         Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SelectedSpawnTemplateDisplayName}" 
                                                       Grid.Row="2" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                                
                                                <TextBlock Text="Description:" Grid.Row="3" Grid.Column="0" 
                                                         Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SelectedSpawnTemplateDescription}" 
                                                       Grid.Row="3" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                                
                                                <TextBlock Text="Primary School:" Grid.Row="4" Grid.Column="0" 
                                                         Foreground="#CCCCCC" FontSize="9" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SelectedSpawnTemplatePrimarySchool}" 
                                                       Grid.Row="4" Grid.Column="1" Height="20" FontSize="9" Margin="0,1" IsReadOnly="True"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- Adjectives -->
                                        <StackPanel Margin="0,4,0,0" IsVisible="{Binding SelectedSpawnGameObjectTemplate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Adjectives:" FontSize="9" FontWeight="Bold" 
                                                     Foreground="#CCCCCC" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding SelectedSpawnGameObjectTemplate.m_adjectiveList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="8" 
                                                                 Foreground="#AAAAAA" Margin="2,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Creature Spell Deck for Spawn Template -->
                                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding HasSpawnDeck}">
                                            <TextBlock Text="Creature Spell Deck:" FontSize="11" FontWeight="Bold" 
                                                     Foreground="#8A2BE2" Margin="0,0,0,8"/>

                                            <!-- Deck editor only when DB available -->
                                            <Border Background="#2A2A2A" Margin="0,2" Padding="8,4" CornerRadius="3" BorderBrush="#8A2BE2" BorderThickness="1" IsVisible="{Binding IsWorldDatabaseReady}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Deck Name -->
                                                    <TextBlock Grid.Column="0" Text="{Binding SelectedSpawnDeckName}" FontSize="10" FontWeight="Bold" 
                                                             Foreground="#8A2BE2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    
                                                    <!-- Edit/Create Deck Button -->
                                                    <Button Grid.Column="1" Content="{Binding SpawnDeckButtonText}" 
                                                            Command="{Binding EditCreatureDeckCommand}"
                                                            Height="24" Width="70" FontSize="9" Background="#8A2BE2" Foreground="White">
                                                        <Button.Styles>
                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Background" Value="#7B68EE"/>
                                                            </Style>
                                                        </Button.Styles>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                                    <!-- Loot Tables for Spawn Template -->
                                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding HasSpawnLootTables}">
                                            <TextBlock Text="{Binding SelectedSpawnTemplateLootTables.Count, StringFormat='Loot Tables ({0}):'}" FontSize="11" FontWeight="Bold" 
                                                     Foreground="#FF6B35" Margin="0,0,0,8"/>
                                            
                                            <!-- Only show when DB available -->
                                            <ItemsControl ItemsSource="{Binding SelectedSpawnTemplateLootTableItems}" IsVisible="{Binding IsWorldDatabaseReady}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#2A2A2A" Margin="0,2" Padding="8,4" CornerRadius="3" BorderBrush="#FF6B35" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Loot Table Name -->
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="#FF6B35" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                
                                                                <!-- Open/Create Button depending on existence -->
                                                                <Button Grid.Column="1" Content="{Binding Label}" 
                                                                        Command="{Binding $parent[UserControl].((vm:ZoneEditorViewModel)DataContext).OpenOrCreateDropTableCommand}"
                                                                        CommandParameter="{Binding Name}"
                                                                        Height="24" Width="70" FontSize="9" Background="#4CAF50" Foreground="White">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button:pointerover">
                                                                            <Setter Property="Background" Value="#45A049"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Fallback status when DB not available -->
                                            <TextBlock Text="{Binding WorldDatabaseStatusText}" 
                                                     FontSize="8" Foreground="#888888" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                                                     IsVisible="{Binding NotWorldDatabaseReady}"/>
                                        </StackPanel>

                                    </StackPanel>

                                <!-- Loading Message while SelectedSpawnTemplate is null -->
                                <StackPanel IsVisible="{Binding SelectedSpawnTemplate, Converter={x:Static ObjectConverters.IsNull}}">
                                    <Border Background="#393939" Padding="4,2" Margin="0">
                                        <TextBlock Text="Template" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="Loading template..." FontSize="9" Foreground="#FFA500" Margin="0,0,0,2"/>
                                        <TextBlock Text="Template data will appear here once loaded from Root.wad" FontSize="8" Foreground="#888888" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- No Selection Message -->
                            <StackPanel IsVisible="{Binding !HasSelectedAnyObject}" Margin="0">
                                <!-- Header -->
                                <Border Background="#393939" Padding="4,2" Margin="0">
                                    <TextBlock Text="No Selection" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                
                                <!-- Message -->
                                <StackPanel Margin="4,8">
                                    <TextBlock Text="Select an object from the hierarchy to view its properties" 
                                             FontSize="9"
                                             Foreground="#888888"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Center"
                                             TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
